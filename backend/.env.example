# Plantilla. Copia este fichero a .env y rellena los valores reales.
#   cp backend/.env.example backend/.env
#
# .env esta en .gitignore y NUNCA debe subirse a git.

# Supabase -> Connect -> Session pooler -> URI
# Sustituye [YOUR-PASSWORD] por la contrasena real, corchetes incluidos.
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase -> Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Publishable key (sb_publishable_...). Va en el frontend, se puede ver.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...): se salta toda la seguridad (RLS).
# Solo en el servidor. Jamas en el frontend ni en git.
SUPABASE_SECRET_KEY=
